{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "src": "/api", "dest": "/api/index.ts" }
  ],
  "crons": [
    {
      "path": "/api/sync/cron",
      "schedule": "0 11 * * *",
      "secret": "TIMBO_SYNC_TOKEN"
    }
  ]
}